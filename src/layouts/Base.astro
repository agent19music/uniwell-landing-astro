---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import "../styles/tokens.css";
import Header from "../components/appdrop/Header.astro";
import Footer from "../components/appdrop/Footer.astro";
import "../styles/theme.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, robots, content } = Astro.props;
const [settingsResult, menuResult, footerProductResult, footerCompanyResult, footerSupportResult] =
	await Promise.all([
		getSiteSettingsWithCacheHint(),
		getMenuWithCacheHint("primary"),
		getMenuWithCacheHint("footer_product"),
		getMenuWithCacheHint("footer_company"),
		getMenuWithCacheHint("footer_support"),
	]);

if (Astro.cache?.enabled) {
	for (const result of [
		settingsResult,
		menuResult,
		footerProductResult,
		footerCompanyResult,
		footerSupportResult,
	]) {
		Astro.cache.set(result.cacheHint);
	}
}

const settings = settingsResult.data;
const siteTitle = settings?.title || "AppDrop";
const fullTitle = title ? (title.includes(siteTitle) ? title : `${title} — ${siteTitle}`) : siteTitle;
const siteDescription = settings?.tagline || "";
const menu = menuResult.data;
const footerProduct = footerProductResult.data;
const footerCompany = footerCompanyResult.data;
const footerSupport = footerSupportResult.data;

const footerColumns = [
	{ heading: "Product", menu: footerProduct },
	{ heading: "More", menu: footerCompany },
	{ heading: "Support", menu: footerSupport },
].filter((col) => col.menu && col.menu.items.length > 0);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteDescription,
	canonical: canonical ?? `${Astro.url.origin}${Astro.url.pathname}`,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});

---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{fullTitle}</title><EmDashHead page={pageCtx}/><Font cssVariable="--font-body" preload/><Font cssVariable="--font-rating"/>
 </head>
 <body>
  <EmDashBodyStart page={pageCtx}/>
  <Header links={menu?.items || [{label:"Benefits",url:"/#benefits"},{label:"Features",url:"/#features"},{label:"Pricing",url:"/#pricing"},{label:"FAQs",url:"/#faqs"}]}/>
  <main><slot/></main>
  <Footer description={siteDescription} columns={footerColumns.map(column => ({title:column.heading,links:column.menu!.items}))}/>
  <EmDashBodyEnd page={pageCtx}/>
  <script>
   if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    document.documentElement.classList.add("ad-motion");
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
     if(entry.isIntersecting){entry.target.classList.add("is-visible");observer.unobserve(entry.target);}
    }), {threshold:0.08});
    document.querySelectorAll("[data-reveal]").forEach(element => observer.observe(element));
   }
  </script>
 </body>
</html>
