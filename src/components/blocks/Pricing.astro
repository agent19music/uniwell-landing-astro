---
import { Image, type BlockComponentProps } from "emdash/ui";
import { sanitizeHref } from "emdash";
import type { PageContentBlock } from "../../../emdash-env";
type Props = BlockComponentProps<Extract<PageContentBlock, { _type: "marketing_pricing" }>>;
const { value } = Astro.props;
---
<section id={value.anchor_id || "pricing"} class="ad-pricing"><div class="ad-container ad-pricing-container"><div class="ad-pricing-layout" data-pricing>
 {value.plans.map(plan => <article class:list={["ad-plan", {"ad-plan-pro": plan.highlighted}]}>
  {plan.highlighted && <div class="ad-plan-switcher"><span>{value.yearly_label}</span><button type="button" class="ad-billing-toggle" role="switch" aria-label="Yearly billing" aria-checked="false" data-billing-toggle><span></span></button></div>}
  <div class="ad-plan-details"><div class="ad-plan-price-wrapper"><h3>{plan.name}</h3><div class="ad-plan-price"><span data-plan-price data-monthly={plan.price} data-yearly={plan.yearly_price || plan.price}>{plan.price}</span><span class="ad-plan-period">{plan.period}</span></div></div>
   {plan.description && <p class="ad-muted">{plan.description}</p>}
   <ul>{(plan.features||"").split("\n").filter(Boolean).map(feature=><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>{feature}</li>)}</ul>
   <a class="ad-button" href={sanitizeHref(plan.cta_url)}>{plan.cta_label}</a>
  </div>
  {plan.highlighted && <img src="/appdrop/XKlz5S2LJ.svg" class="ad-pricing-notch" alt=""/>}
 </article>)}
 {value.image && <div class="ad-pricing-screen-wrapper"><div class="ad-pricing-screen" data-reveal><Image image={value.image} class="ad-pricing-screen-image"/></div></div>}
</div></div></section>
<script>
 document.querySelectorAll<HTMLElement>("[data-pricing]").forEach(pricing=>{
  const toggle=pricing.querySelector<HTMLButtonElement>("[data-billing-toggle]");
  toggle?.addEventListener("click",()=>{const yearly=toggle.getAttribute("aria-checked")!=="true";toggle.setAttribute("aria-checked",String(yearly));pricing.querySelectorAll<HTMLElement>("[data-plan-price]").forEach(price=>{price.textContent=(yearly?price.dataset.yearly:price.dataset.monthly)||"";});});
 });
</script>
