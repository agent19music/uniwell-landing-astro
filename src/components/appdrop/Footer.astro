---
import { sanitizeHref } from "emdash";
interface Props { description: string; columns: {title:string;links:{label:string;url:string}[]}[]; }
const { description, columns } = Astro.props;
---
<footer class="ad-footer">
	<div class="ad-footer-container">
		<div class="ad-footer-main">
			<div class="ad-footer-info">
				<a href="/#hero" class="ad-logo"><img src="/appdrop/o7nBenf5iYP2umLrTl50Y4Fiek.png" width="36" height="36" alt="" /><span>AppDrop</span></a>
				<p>{description}</p>
				<div class="ad-social-links">
					<a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
					<a href="https://x.com/zainmalikig" target="_blank" rel="noopener noreferrer" aria-label="Twitter"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg></a>
					<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg></a>
					<a href="mailto:help@appdrop.com" class="ad-button ad-button-secondary">Contact</a>
				</div>
			</div>
			<div class="ad-footer-links">
				{columns.map(column => <div><h3>{column.title}</h3>{column.links.map(link => <a href={sanitizeHref(link.url)}>{link.label}</a>)}</div>)}
			</div>
		</div>
		<div class="ad-footer-bottom"><p>AppDrop © 2026. All rights reserved.</p><p>Template by <a href="https://framer.com/@zain" target="_blank" rel="noopener noreferrer">Zain Malik</a></p></div>
	</div>
</footer>
<a class="ad-remix" href="https://framer.link/poOzPgO" target="_blank" rel="noopener noreferrer"><img src="/appdrop/Oc9nW18lPSQBp8tkSyNriRMN2e0.jpg" alt="AppDrop template preview" width="130" height="82" /><span>Remix for Free</span></a>
